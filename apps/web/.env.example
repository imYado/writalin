# Neon Postgres connection string (Vercel → Storage → Neon adds this automatically).
DATABASE_URL=postgres://user:password@ep-example.neon.tech/neondb?sslmode=require
# Resend API key for login-code emails. Without it, codes print to the server log (dev only).
RESEND_API_KEY=
# Defaults to onboarding@resend.dev, which only reaches your own Resend account email.
EMAIL_FROM=Writalin <login@your-domain.com>
# Extra origins allowed to call the API, comma separated (e.g. the Chrome extension).
ALLOWED_ORIGINS=chrome-extension://your-extension-id
# --- AI helper (optional) ---
# Built-in Anthropic key. Stays on the server; the browser never sees it.
ANTHROPIC_API_KEY=
# Encrypts the API keys people save for themselves. 32+ random characters,
# e.g. `openssl rand -base64 48`. Changing it makes saved keys unreadable (people re-enter them).
AI_KEY_ENCRYPTION_SECRET=
# Optional overrides.
AI_MODEL=claude-opus-5-5
AI_DAILY_LIMIT_BUILTIN=40
AI_DAILY_LIMIT_OWN=300
